#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$PROJECT_ROOT/../.." && pwd)"

if [ -f "$REPO_ROOT/.env" ]; then
  set -a
  # shellcheck source=/dev/null
  . "$REPO_ROOT/.env"
  set +a
fi

die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }
file_mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }

implementation_dir() {
  if [ -d "$PROJECT_ROOT/solutions/$1" ]; then
    printf '%s\n' "$PROJECT_ROOT/solutions/$1"
  else
    printf '%s\n' "$PROJECT_ROOT/$1"
  fi
}

forced_lang=""
passthrough=()
while [ $# -gt 0 ]; do
  case "$1" in
    --lang)
      [ $# -ge 2 ] || die "--lang requires ts, rust, or scala"
      case "$2" in ts|rust|scala) forced_lang="$2" ;; *) die "unknown language: $2" ;; esac
      shift 2
      ;;
    *) passthrough+=("$1"); shift ;;
  esac
done

candidates=()
mtimes=()
for candidate in ts rust scala; do
  root="$(implementation_dir "$candidate")"
  built=false
  main=""
  case "$candidate" in
    ts) [ -d "$root/node_modules" ] && built=true; main="$root/src/main.ts" ;;
    rust)
      { [ -x "$root/target/release/tabbyshell" ] || [ -x "$root/target/debug/tabbyshell" ]; } && built=true
      main="$root/src/main.rs"
      ;;
    scala)
      compgen -G "$root/target/scala-*/*-assembly-*.jar" >/dev/null && built=true
      main="$root/src/main/scala/Main.scala"
      ;;
  esac
  if $built; then
    candidates+=("$candidate")
    mtimes+=("$(file_mtime "$main")")
  fi
done

lang=""
if [ -n "$forced_lang" ]; then
  for candidate in "${candidates[@]+"${candidates[@]}"}"; do
    [ "$candidate" = "$forced_lang" ] && lang="$candidate"
  done
  [ -n "$lang" ] || die "$forced_lang TabbyShell is not built"
elif [ ${#candidates[@]} -eq 0 ]; then
  die "no built TabbyShell found; run capstones/tabbyshell/verify with an explicit implementation root"
else
  best=0
  for ((i = 1; i < ${#candidates[@]}; i++)); do
    [ "${mtimes[$i]}" -le "${mtimes[$best]}" ] || best=$i
  done
  lang="${candidates[$best]}"
fi

root="$(implementation_dir "$lang")"
export TABBY_PROJECT_ROOT="$PROJECT_ROOT"
case "$lang" in
  ts)
    cd "$root"
    exec npx tsx src/main.ts "${passthrough[@]+"${passthrough[@]}"}"
    ;;
  rust)
    cd "$root"
    if [ -x target/release/tabbyshell ]; then
      exec target/release/tabbyshell "${passthrough[@]+"${passthrough[@]}"}"
    fi
    exec target/debug/tabbyshell "${passthrough[@]+"${passthrough[@]}"}"
    ;;
  scala)
    jar="$(find "$root/target" -path '*/scala-*/*-assembly-*.jar' -type f | head -n 1)"
    [ -n "$jar" ] || die "Scala assembly JAR not found"
    java_cmd=java
    [ ! -x /opt/homebrew/opt/openjdk/bin/java ] || java_cmd=/opt/homebrew/opt/openjdk/bin/java
    cd "$root"
    exec "$java_cmd" -jar "$jar" "${passthrough[@]+"${passthrough[@]}"}"
    ;;
esac
